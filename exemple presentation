def generer_html():
slides_json = json.dumps(SLIDES, ensure_ascii=False)
return HTML_MAIN.replace("__SLIDES_JSON__", slides_json)


class Handler(BaseHTTPRequestHandler):
def log_message(self, *args):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Cache-Control", "no-cache")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def do_GET(self):
parsed = urlparse(self.path)
path = parsed.path

if path in ("/", "/index.html"):
return self._send(200, generer_html())

if path == "/api/slides":
return self._send(200, json.dumps(SLIDES, ensure_ascii=False, indent=2),
"application/json; charset=utf-8")

if path == "/api/status":
return self._send(200, json.dumps({
"version": VERSION, "auteur": AUTEUR,
"nb_slides": len(SLIDES),
"duree_totale": sum(s.get("duration", 6) for s in SLIDES),
}, ensure_ascii=False, indent=2), "application/json; charset=utf-8")

return self._send(404, "404 — Not found")


class Server(ThreadingMixIn, HTTPServer):
daemon_threads = True
allow_reuse_address = True


def port_libre(host, port):
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
s.settimeout(1)
s.bind((host, port))
return True
except OSError:
return False
finally:
try:
s.close()
except Exception:
pass


def trouver_port(host, start, max_tries=20):
for p in range(start, start + max_tries):
if port_libre(host, p):
return p
return None


