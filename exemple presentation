<script>
var SLIDES = __SLIDES_JSON__;

var state = {
current: 0,
playing: false,
speed: 1.0,
timer: null,
slideEls: []
};

function escapeHtml(str) {
if (str === null || str === undefined) return '';
return String(str)
.replace(/&/g, '&amp;')
.replace(/</g, '&lt;')
.replace(/>/g, '&gt;')
.replace(/"/g, '&quot;')
.replace(/'/g, '&#39;');
}

function highlightCode(lines) {
return lines.map(function(line) {
var l = escapeHtml(line);
if (l.indexOf('$ ') === 0) {
l = '<span class="prompt">$</span> ' + l.substring(2);
}
if (l.indexOf('#') === 0) {
l = '<span class="comment">' + l + '</span>';
}
return l;
}).join('\\n');
}

function buildSlideHTML(slide) {
var type = slide.type;
var accent = slide.accent;
var inner = '';

if (type === 'cover') {
inner = '<h1 class="cover-title">' + escapeHtml(slide.title) + '</h1>'
+ '<div class="cover-subtitle">' + escapeHtml(slide.subtitle) + '</div>'
+ '<div class="cover-tagline">' + escapeHtml(slide.tagline) + '</div>';
} else if (type === 'quote') {
inner = '<h2 class="slide-title">' + escapeHtml(slide.title) + '</h2>'
+ '<div class="quote-text">' + escapeHtml(slide.text) + '</div>';
} else if (type === 'statement') {
var linesHtml = slide.lines.map(function(l) {
return '<div class="statement-line">' + escapeHtml(l) + '</div>';
}).join('');
inner = '<h2 class="slide-title">' + escapeHtml(slide.title) + '</h2>'
+ '<div class="statement-lines">' + linesHtml + '</div>';
} else if (type === 'features') {
var itemsHtml = slide.items.map(function(it) {
return '<div class="feature-card">'
+ '<div class="feature-icon">' + escapeHtml(it.icon) + '</div>'
+ '<div class="feature-label">' + escapeHtml(it.label) + '</div>'
+ '<div class="feature-detail">' + escapeHtml(it.detail) + '</div>'
+ '</div>';
}).join('');
inner = '<h2 class="slide-title">' + escapeHtml(slide.title) + '</h2>'
+ '<div class="features-grid">' + itemsHtml + '</div>';
} else if (type === 'formula') {
inner = '<h2 class="slide-title">' + escapeHtml(slide.title) + '</h2>'
+ '<div class="formula-box">'
+ '<div class="formula-expr">' + escapeHtml(slide.formula) + '</div>'
+ '<div class="formula-result">' + escapeHtml(slide.result) + '</div>'
+ '</div>'
+ '<div class="formula-note">' + escapeHtml(slide.note) + '</div>';
} else if (type === 'stats') {
var statsHtml = slide.items.map(function(it) {
return '<div class="stat-box">'
+ '<div class="stat-value">' + escapeHtml(it.value) + '</div>'
+ '<div class="stat-label">' + escapeHtml(it.label) + '</div>'
+ '</div>';
}).join('');
inner = '<h2 class="slide-title">' + escapeHtml(slide.title) + '</h2>'
+ '<div class="stats-grid">' + statsHtml + '</div>';
} else if (type === 'code') {
inner = '<h2 class="slide-title">' + escapeHtml(slide.title) + '</h2>'
+ '<div class="code-block">' + highlightCode(slide.code) + '</div>';
}

return '<div class="slide" data-accent="' + accent + '" data-id="' + slide.id + '">'
+ inner + '</div>';
}

function initSlides() {
var stage = document.getElementById('stage');
var html = SLIDES.map(buildSlideHTML).join('');
stage.innerHTML = html;
state.slideEls = Array.prototype.slice.call(stage.querySelectorAll('.slide'));
document.getElementById('tot-slide').textContent = String(SLIDES.length).padStart(2, '0');
if (state.slideEls.length > 0) {
state.slideEls[0].classList.add('active');
}
updateProgress();
}

function showSlide(index) {
if (index < 0 || index >= SLIDES.length) return;
var old = state.slideEls[state.current];
var neu = state.slideEls[index];
if (old && old !== neu) {
old.classList.remove('active');
old.classList.add('exiting');
setTimeout(function() { old.classList.remove('exiting'); }, 1000);
}
if (neu) {
neu.classList.add('active');
}
state.current = index;
document.getElementById('cur-slide').textContent = String(index + 1).padStart(2, '0');
updateProgress();
restartTimer();
}

function updateProgress() {
