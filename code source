def euler_ode(f, t0, y0, t_end, h=0.01):
"""Methode d'Euler."""
t = t0
y = y0
pts = [(t, y)]
while t < t_end:
y += h * f(t, y)
t += h
pts.append((t, y))
return pts


def rk4_ode(f, t0, y0, t_end, h=0.01):
"""Runge-Kutta d'ordre 4."""
t = t0
y = y0
pts = [(t, y)]
while t < t_end:
k1 = f(t, y)
k2 = f(t + h / 2, y + h * k1 / 2)
k3 = f(t + h / 2, y + h * k2 / 2)
k4 = f(t + h, y + h * k3)
y += h * (k1 + 2 * k2 + 2 * k3 + k4) / 6
t += h
pts.append((t, y))
return pts


