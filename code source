def derivee(f, x, h=1e-6):
"""Derivee numerique centree."""
return (f(x + h) - f(x - h)) / (2 * h)


def derivee_seconde(f, x, h=1e-5):
return (f(x + h) - 2 * f(x) + f(x - h)) / (h * h)


def integrale_simpson(f, a, b, n=1000):
"""Integration numerique par Simpson (n doit etre pair)."""
if n % 2:
n += 1
h = (b - a) / n
s = f(a) + f(b)
for i in range(1, n):
s += (4 if i % 2 else 2) * f(a + i * h)
return s * h / 3


def integrale_trapeze(f, a, b, n=10000):
h = (b - a) / n
s = 0.5 * (f(a) + f(b))
for i in range(1, n):
s += f(a + i * h)
return s * h


def integrale_gauss(f, a, b, n=50):
"""Quadrature de Gauss-Legendre a n points (extrait de tables)."""
# Points et poids pour n=8 (suffisant pour test)
xs = [-0.9602898564975363, -0.7966664774136267,
-0.5255324099163290, -0.1834346424956498,
0.1834346424956498, 0.5255324099163290,
0.7966664774136267, 0.9602898564975363]
ws = [ 0.1012285362903763, 0.2223810344533745,
0.3137066458778873, 0.3626837833783620,
0.3626837833783620, 0.3137066458778873,
0.2223810344533745, 0.1012285362903763]
c = 0.5 * (b - a)
d = 0.5 * (b + a)
return c * sum(w * f(c * x + d) for x, w in zip(xs, ws))


def newton_raphson(f, df, x0, tol=1e-12, max_iter=100):
x = x0
for _ in range(max_iter):
fx = f(x)
if abs(fx) < tol:
return x
dfx = df(x)
if abs(dfx) < 1e-15:
raise ValueError("derivee nulle")
x = x - fx / dfx
return x


def bissection(f, a, b, tol=1e-12, max_iter=200):
fa = f(a)
fb = f(b)
if fa * fb > 0:
raise ValueError("f(a) et f(b) doivent etre de signes opposes")
for _ in range(max_iter):
m = 0.5 * (a + b)
fm = f(m)
if abs(fm) < tol or (b - a) / 2 < tol:
return m
if fa * fm < 0:
b = m
fb = fm
else:
a = m
fa = fm
return 0.5 * (a + b)


def limite(f, x0, direction="both", h=1e-7):
if direction == "left":
return f(x0 - h)
if direction == "right":
return f(x0 + h)
return 0.5 * (f(x0 - h) + f(x0 + h))


