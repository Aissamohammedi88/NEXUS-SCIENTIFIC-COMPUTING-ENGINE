def omega_constant_iter(max_iter=200, tol=1e-15):
"""Omega par iteration x_{n+1} = e^{-x_n}."""
x = 1.0
for _ in range(max_iter):
xn = math.exp(-x)
if abs(xn - x) < tol:
return xn
x = xn
return x


def lambert_w(x, branch=0, max_iter=200, tol=1e-15):
"""Lambert W par iteration de Halley. Marche pour x >= -1/e (branche 0)."""
if x == 0:
return 0.0
if branch == -1:
if x < -1 / math.e or x >= 0:
raise ValueError("branche -1 : -1/e <= x < 0")
w = -1.5
else:
w = 0.5 if x > 0 else -0.5
for _ in range(max_iter):
ew = math.exp(w)
f = w * ew - x
fp = ew * (w + 1)
fpp = ew * (w + 2)
denom = fp - f * fpp / (2 * fp)
if denom == 0:
break
wn = w - f / denom
if abs(wn - w) < tol:
return wn
w = wn
return w


def zeta_approx(s, terms=200000):
"""Approximation de zeta(s) pour s reel > 1 (somme directe)."""
if s == 1:
raise ValueError("pole en s=1")
if s <= 1:
# continuation rudimentaire via formule de reflexion (approximation)
return (2 ** s) * (PI ** (s - 1)) * math.sin(PI * s / 2) * math.gamma(1 - s) * zeta_approx(1 - s + 1, terms)
return sum(1.0 / (k ** s) for k in range(1, terms + 1))


def gamma_lanczos(z):
"""Gamma via approximation de Lanczos (stdlib pure)."""
g = 7
C = [0.99999999999980993,
676.5203681218851,
-1259.1392167224028,
771.32342877765313,
-176.61502916214059,
12.507343278686905,
-0.13857109526572012,
9.9843695780195716e-6,
1.5056327351493116e-7]
if z < 0.5:
return PI / (math.sin(PI * z) * gamma_lanczos(1 - z))
z -= 1
x = C[0]
for i in range(1, g + 2):
x += C[i] / (z + i)
t = z + g + 0.5
return math.sqrt(2 * PI) * (t ** (z + 0.5)) * math.exp(-t) * x


def beta_function(a, b):
return gamma_lanczos(a) * gamma_lanczos(b) / gamma_lanczos(a + b)


def digamma_approx(x, h=1e-5):
"""Digamma par difference finie sur log-gamma."""
return (math.log(gamma_lanczos(x + h)) - math.log(gamma_lanczos(x - h))) / (2 * h)


def bessel_j0(x):
"""Bessel J0 par serie."""
s = 0.0
for k in range(50):
s += ((-1) ** k) * ((x / 2) ** (2 * k)) / ((math.factorial(k)) ** 2)
return s


def bessel_j1(x):
s = 0.0
for k in range(50):
s += ((-1) ** k) * ((x / 2) ** (2 * k + 1)) / (math.factorial(k) * math.factorial(k + 1))
return s


def airy_ai(x):
"""Airy Ai par serie de Taylor."""
s = 0.0
for k in range(40):
s += (x ** (3 * k)) / (math.factorial(k) * math.factorial(int(1.5 * k + 0.5)) * 3 ** (2 * k / 3 + 1 / 3))
return 0.355028053887817 * s


