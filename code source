class Handler(BaseHTTPRequestHandler):
server_version = "NexusScience/" + VERSION
protocol_version = "HTTP/1.1"

def log_message(self, *a):
pass

def _send(self, code, body, ctype="application/json; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
try:
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
pass

def _json(self, code, obj):
self._send(code, json.dumps(obj, indent=2, ensure_ascii=False, default=str))

def _html(self, code, text):
self._send(code, text, "text/html; charset=utf-8")

def _body_json(self):
try:
length = int(self.headers.get("Content-Length", "0") or "0")
except Exception:
length = 0
if length <= 0 or length > 2_000_000:
return {}
try:
return json.loads(self.rfile.read(length).decode("utf-8", "ignore") or "{}")
except Exception:
return {}

def _parse(self):
p = urllib.parse.urlparse(self.path)
return p.path, urllib.parse.parse_qs(p.query)

def do_GET(self):
path, qs = self._parse()
try:
if path in ("/", "/index.html"):
return self._html(200, HTML.replace("__V__", VERSION))

if path == "/api/status":
return self._json(200, {
"ok": True, "version": VERSION, "auteur": AUTEUR,
"host": HOST, "port": PORT, "log": LOG_FILE,
})

if path == "/api/constantes":
return self._json(200, {"ok": True,
"constantes": constantes_liste()})

if path == "/api/ping":
return self._json(200, {"ok": True, "ping": "pong"})

return self._json(404, {"ok": False, "err": "route inconnue"})
except Exception as e:
log("GET err " + str(e)[:150])
return self._json(500, {"ok": False, "err": str(e)[:200]})

def do_POST(self):
path, qs = self._parse()
try:
data = self._body_json()

if path == "/api/omega":
r = dispatch_omega(data.get("fn", ""),
data.get("a", "0"), data.get("b", "0"))
return self._json(200, r)

if path == "/api/linalg":
r = dispatch_linalg(data.get("fn", ""),
data.get("A", "[[1]]"),
data.get("b", "[]"))
return self._json(200, r)

if path == "/api/calcul":
r = dispatch_calcul(data.get("fn", ""),
data.get("expr", "x"),
data.get("a", "0"),
data.get("b", "1"))
return self._json(200, r)

if path == "/api/stats":
r = dispatch_stats(data.get("fn", ""),
data.get("data", ""),
data.get("data2", ""),
data.get("p", "50"))
return self._json(200, r)

if path == "/api/nombres":
r = dispatch_nombres(data.get("fn", ""),
data.get("n", "1"),
data.get("k", "1"))
return self._json(200, r)

if path == "/api/fourier":
r = dispatch_fourier(data.get("fn", ""),
data.get("data", ""))
return self._json(200, r)

if path == "/api/physique":
r = dispatch_physique(data.get("fn", ""),
data.get("a", "0"),
data.get("b", "0"),
data.get("c", "0"))
