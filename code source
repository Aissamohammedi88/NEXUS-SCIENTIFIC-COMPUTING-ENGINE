def stats_descriptives(xs):
n = len(xs)
if n == 0:
return {"err": "liste vide"}
m = sum(xs) / n
var = sum((x - m) ** 2 for x in xs) / n
var_s = sum((x - m) ** 2 for x in xs) / (n - 1) if n > 1 else 0.0
xs_tri = sorted(xs)
med = xs_tri[n // 2] if n % 2 else 0.5 * (xs_tri[n // 2 - 1] + xs_tri[n // 2])
return {
"n": n, "moyenne": m, "variance": var, "variance_echantillon": var_s,
"ecart_type": math.sqrt(var), "ecart_type_echantillon": math.sqrt(var_s),
"min": min(xs), "max": max(xs), "mediane": med,
"somme": sum(xs),
}


def covariance(xs, ys):
n = len(xs)
mx = sum(xs) / n
my = sum(ys) / n
return sum((xs[i] - mx) * (ys[i] - my) for i in range(n)) / n


def correlation(xs, ys):
cov = covariance(xs, ys)
sx = math.sqrt(covariance(xs, xs))
sy = math.sqrt(covariance(ys, ys))
if sx * sy == 0:
return 0.0
return cov / (sx * sy)


def regression_lineaire(xs, ys):
"""Retourne a, b pour y = a*x + b."""
n = len(xs)
mx = sum(xs) / n
my = sum(ys) / n
num = sum((xs[i] - mx) * (ys[i] - my) for i in range(n))
den = sum((x - mx) ** 2 for x in xs)
if den == 0:
return 0.0, my
a = num / den
b = my - a * mx
return a, b


def percentile(xs, p):
if not xs:
return None
s = sorted(xs)
k = (len(s) - 1) * p / 100.0
f = math.floor(k)
c = math.ceil(k)
if f == c:
return s[int(k)]
return s[int(f)] + (s[int(c)] - s[int(f)]) * (k - f)


def combinaison(n, k):
if k < 0 or k > n:
return 0
return math.comb(n, k)


def arrangement(n, k):
if k < 0 or k > n:
return 0
return math.perm(n, k)


