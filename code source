def energie_cinetique(m, v):
return 0.5 * m * v * v


def energie_potentielle(m, g, h):
return m * g * h


def force_gravitation(m1, m2, r, G=6.674e-11):
return G * m1 * m2 / (r * r)


def force_electrique(q1, q2, r, k=8.9875517923e9):
return k * q1 * q2 / (r * r)


def onde_frequence(longueur, vitesse):
return vitesse / longueur


def einstein_energie(m, c=299792458):
return m * c * c


def lorentz_factor(v, c=299792458):
if abs(v) >= c:
raise ValueError("v >= c")
return 1.0 / math.sqrt(1 - (v / c) ** 2)


def orbite_circulaire(M, r, G=6.674e-11):
return math.sqrt(G * M / r)


