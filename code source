def dft(xs):
"""Transformee de Fourier discrete (implementation directe)."""
N = len(xs)
out = []
for k in range(N):
s = 0 + 0j
for n in range(N):
s += xs[n] * cmath.exp(-2j * math.pi * k * n / N)
out.append(s)
return out


def idft(Xs):
N = len(Xs)
out = []
for n in range(N):
s = 0 + 0j
for k in range(N):
s += Xs[k] * cmath.exp(2j * math.pi * k * n / N)
out.append(s / N)
return out


def fft(xs):
"""FFT recursive (radix-2)."""
N = len(xs)
if N & (N - 1):
raise ValueError("N doit etre puissance de 2")
if N <= 1:
return [complex(x) for x in xs]
pairs = fft(xs[0::2])
impairs = fft(xs[1::2])
out = [0j] * N
for k in range(N // 2):
t = cmath.exp(-2j * math.pi * k / N) * impairs[k]
out[k] = pairs[k] + t
out[k + N // 2] = pairs[k] - t
return out


