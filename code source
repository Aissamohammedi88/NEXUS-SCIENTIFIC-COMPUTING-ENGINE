def est_premier(n):
if n < 2:
return False
if n < 4:
return True
if n % 2 == 0:
return False
i = 3
while i * i <= n:
if n % i == 0:
return False
i += 2
return True


def crible_eratosthene(n):
"""Tous les premiers <= n."""
if n < 2:
return []
sieve = [True] * (n + 1)
sieve[0] = sieve[1] = False
i = 2
while i * i <= n:
if sieve[i]:
for j in range(i * i, n + 1, i):
sieve[j] = False
i += 1
return [i for i, v in enumerate(sieve) if v]


def factorisation(n):
"""Factorisation en nombres premiers."""
if n <= 0:
return {"err": "n doit etre positif"}
facteurs = {}
d = 2
while d * d <= n:
while n % d == 0:
facteurs[d] = facteurs.get(d, 0) + 1
n //= d
d += 1 if d == 2 else 2
if n > 1:
facteurs[n] = facteurs.get(n, 0) + 1
return facteurs


def pgcd(a, b):
while b:
a, b = b, a % b
return abs(a)


def ppcm(a, b):
return abs(a * b) // pgcd(a, b) if a and b else 0


def totiente_euler(n):
"""phi(n) : nombre d'entiers <= n premiers avec n."""
result = n
p = 2
nn = n
while p * p <= nn:
if nn % p == 0:
while nn % p == 0:
nn //= p
result -= result // p
p += 1
if nn > 1:
result -= result // nn
return result


def partition_count(n, memo=None):
"""Nombre de partitions de n (recurrence d'Euler)."""
if memo is None:
memo = {}
if n in memo:
return memo[n]
if n == 0:
return 1
if n < 0:
return 0
s = 0
k = 1
while True:
g1 = k * (3 * k - 1) // 2
g2 = k * (3 * k + 1) // 2
if g1 > n and g2 > n:
break
signe = 1 if k % 2 else -1
s += signe * (partition_count(n - g1, memo) + partition_count(n - g2, memo))
k += 1
memo[n] = s
return s


