def mat_dot(A, B):
n, m = len(A), len(A[0])
p = len(B[0])
if len(B) != m:
raise ValueError("dimensions incompatibles")
C = [[0.0] * p for _ in range(n)]
for i in range(n):
for j in range(p):
s = 0.0
for k in range(m):
s += A[i][k] * B[k][j]
C[i][j] = s
return C


def mat_transpose(A):
return [list(row) for row in zip(*A)]


def mat_identity(n):
return [[1.0 if i == j else 0.0 for j in range(n)] for i in range(n)]


def mat_det(A):
"""Determinant par elimination de Gauss (pivot partiel)."""
n = len(A)
M = [row[:] for row in A]
det = 1.0
for i in range(n):
p = max(range(i, n), key=lambda r: abs(M[r][i]))
if abs(M[p][i]) < 1e-15:
return 0.0
if p != i:
M[i], M[p] = M[p], M[i]
det = -det
det *= M[i][i]
for r in range(i + 1, n):
f = M[r][i] / M[i][i]
for c in range(i, n):
M[r][c] -= f * M[i][c]
return det


def mat_inverse(A):
"""Inverse par Gauss-Jordan."""
n = len(A)
M = [row[:] + [1.0 if i == j else 0.0 for j in range(n)] for i, row in enumerate(A)]
for i in range(n):
p = max(range(i, n), key=lambda r: abs(M[r][i]))
if abs(M[p][i]) < 1e-15:
raise ValueError("matrice singuliere")
M[i], M[p] = M[p], M[i]
piv = M[i][i]
for c in range(2 * n):
M[i][c] /= piv
for r in range(n):
if r == i:
continue
f = M[r][i]
for c in range(2 * n):
M[r][c] -= f * M[i][c]
return [row[n:] for row in M]


def mat_solve(A, b):
"""Resout Ax = b par Gauss."""
n = len(A)
M = [A[i][:] + [b[i]] for i in range(n)]
for i in range(n):
p = max(range(i, n), key=lambda r: abs(M[r][i]))
M[i], M[p] = M[p], M[i]
piv = M[i][i]
if abs(piv) < 1e-15:
raise ValueError("singuliere")
for r in range(i + 1, n):
f = M[r][i] / piv
for c in range(i, n + 1):
M[r][c] -= f * M[i][c]
x = [0.0] * n
for i in range(n - 1, -1, -1):
s = M[i][n] - sum(M[i][j] * x[j] for j in range(i + 1, n))
x[i] = s / M[i][i]
return x


def mat_power(A, p):
n = len(A)
R = mat_identity(n)
B = [row[:] for row in A]
while p > 0:
if p & 1:
R = mat_dot(R, B)
B = mat_dot(B, B)
p >>= 1
return R


def mat_trace(A):
return sum(A[i][i] for i in range(len(A)))


def mat_norm_fro(A):
return math.sqrt(sum(A[i][j] ** 2 for i in range(len(A)) for j in range(len(A[0]))))


